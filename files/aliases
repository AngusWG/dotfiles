# source ~/.aliases
alias rm='trash'
alias dc='sudo docker compose'
alias dl='sudo docker logs --tail 50'
alias dlf='sudo docker logs -f --tail 50'
alias wgdu='sudo docker-compose down --remove-orphans  && sudo docker-compose up -d'

_do_up_zip_all() {
    setopt local_options nullglob
    local files=(*.zip *.rar *.7z)

    if [ ${#files[@]} -eq 0 ]; then
        echo "未发现压缩文件，跳过。"
        return
    fi

    for arc in "${files[@]}"; do
        if [ -f "$arc" ]; then
            echo "正在处理: $arc"
            if 7z x "$arc" -y; then
                echo "解压成功，删除源文件..."
                rm "$arc"
            else
                echo "警告: $arc 解压失败，保留原文件！"
            fi
        fi
    done
}

alias unzip_all='_do_up_zip_all'
